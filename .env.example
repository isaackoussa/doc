# Copiez ce fichier en « .env » et remplissez ce dont vous avez besoin.

# --- IA (discussion, studio, lecture des photos/PDF scannés) ---
# Clé à créer sur https://platform.claude.com
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut : claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- Voix premium (facultatif) ---
# Sans clé, l'app utilise les voix du navigateur (gratuites).
# ElevenLabs : les voix les plus naturelles, multilingues.
ELEVENLABS_API_KEY=
# OpenAI : très bonnes voix, moins chères.
OPENAI_API_KEY=

# PORT=3000
